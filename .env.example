# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret: only used on the server (creating cleaner logins). Never expose it.
SUPABASE_SERVICE_ROLE_KEY=

# Time zone used for "today" in the app.
NEXT_PUBLIC_TIME_ZONE=America/Sao_Paulo

# Hospitable → Settings → Apps → API access → Personal access token
HOSPITABLE_API_TOKEN=
# Any long random string. Protects /api/cron/sync (Vercel Cron sends it automatically).
CRON_SECRET=
